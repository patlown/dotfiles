;; Kanata keyboard configuration file
;; This file defines custom key mappings and behaviors.

;; Global configuration options.
(defcfg
  process-unmapped-keys yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    "Apple Internal Keyboard"
    "Adv360 Pro"
  )
)

;; Define the physical keys we want to remap.
(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10   f11   f12
  caps a s d f j k l ; z /
  fn
)

;; Variables for consistent timing across tap-hold behaviors.
(defvar
  tap-time 150
  hold-time 200
)

;; Key aliases.
(defalias
  ;; Simple remapping: Caps Lock becomes Escape.
  caps esc

  ;; Home row modifiers.
  a (tap-hold $tap-time $hold-time a lmet)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $hold-time d lctl)
  f (tap-hold $tap-time $hold-time f lsft)

  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k rctl)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ; rmet)

  ;; Additional control keys on outer positions.
  z (tap-hold $tap-time $hold-time z lctl)
  / (tap-hold $tap-time $hold-time / rctl)

  ;; Function layer toggle.
  fnl (tap-hold 200 200 fn (layer-toggle fn))
)

;; Main/default layer.
(deflayer base
  brdn  brup  _    _    _    _   prev  pp  next  mute  vold  volu
  @caps @a @s @d @f @j @k @l @; @z @/
  @fnl
)

;; Function layer.
(deflayer fn
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10   f11   f12
  @caps _ _ _ _ _ _ _ _ _ _
  fn
)
