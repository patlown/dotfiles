[user]
	name = pat
	email = patlown@pm.me

[init]
	defaultBranch = main

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = false

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[pull]
	rebase = false

[push]
	default = current
	autoSetupRemote = true

[alias]
	# Short status
	s = status -s
	st = status

	# Commits
	c = commit
	cm = commit -m
	ca = commit --amend

	# Branches
	b = branch
	co = checkout
	cob = checkout -b

	# Diff
	d = diff
	ds = diff --staged

	# Logging
	lg = log --oneline --graph --decorate -15
	lga = log --oneline --graph --decorate --all -15
	ll = log --pretty=format:'%C(yellow)%h%Creset %s %C(cyan)<%an>%Creset %C(green)(%cr)%Creset' -15

	# Undo
	undo = reset --soft HEAD~1
	unstage = reset HEAD --

	# Stash
	ss = stash
	sp = stash pop
	sl = stash list

[color]
	ui = auto

[help]
	autocorrect = 10
